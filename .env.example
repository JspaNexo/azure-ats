# ==============================================================================
# ATS TalentIQ - Variables de Entorno de Ejemplo (.env.example)
# Copie este archivo a .env y configure sus valores antes de iniciar el sistema:
#   cp .env.example .env
# ==============================================================================

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ats_db
POSTGRES_PORT=5433

# Cadena de conexión para desarrollo local (fuera de contenedores)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=ats_db;Username=postgres;Password=postgres

# Google Gemini API
# Obtenga su clave de API gratuita en: https://aistudio.google.com/app/apikey
Gemini__ApiKey=TU_API_KEY_DE_GEMINI_AQUI
Gemini__Model=gemini-flash-lite-latest

# Claves de Integración Interna y Webhooks
Ingestion__ApiKey=ats_internal_dev_key_2026
Webhooks__Secret=ats_webhook_secret_2026

# Observabilidad con Seq
SEQ_ADMIN_PASSWORD=Admin12345!
Serilog__WriteTo__1__Args__serverUrl=http://localhost:5341
